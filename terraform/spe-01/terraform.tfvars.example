# SPE-01 Terraform variables — copy to terraform.tfvars and customize.
# Do NOT commit terraform.tfvars if it contains secrets or restrictive CIDRs.

aws_profile = "nebula"
aws_region  = "us-east-1"

project_name = "financial-app"
environment  = "spe-01"

instance_type         = "t3.micro"
root_volume_size_gb   = 30

# Required: existing EC2 key pair name in us-east-1
ssh_key_name = "your-ec2-key-pair-name"

# REQUIRED: operator public IP only (example — replace with your IP/32)
# Chosen CIDR for documentation: single-operator home/office egress
ssh_allowed_cidrs = ["203.0.113.10/32"]

# HTTP access for demo (browser access)
http_allowed_cidrs = ["0.0.0.0/0"]

# Pinned image from deployable publish (update SHA after each release)
docker_image = "taig2k/finance_app_for_aws:89a4ea50348c73a8fcaf47c95ad7fb24a803d16d"

openai_ssm_parameter_name = "/financial-app/spe-01/openai_api_key"

# Pass at apply time only (creates SSM SecureString; not written to user-data):
#   export TF_VAR_openai_api_key="sk-..."
#   terraform apply -var-file=terraform.tfvars
